# ==============================================================================
# ADRASTEA CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your confidential values.
# .env is ignored by Git and will NEVER be committed.
# ==============================================================================

# System Settings
ADRASTEA_ENV=development
ADRASTEA_IPC_HOST=127.0.0.1
ADRASTEA_IPC_PORT=8765

# Alpha Engine Configuration
ALPHA_TICK_INTERVAL_SECONDS=5
ALPHA_STABILIZATION_SECONDS=3
ALPHA_MAX_CONCURRENT_TASKS=4

# Beta Engine Configuration
BETA_TICK_INTERVAL_SECONDS=10
BETA_IDLE_CYCLE_SECONDS=30
BETA_ENABLE_MCP=true

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-coder:30b

# Cloud / Frontier LLM (Optional - fallback to Ollama if empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Notification Settings: Recipient (Configure in local .env - NEVER commit personal info)
NOTIFICATION_TARGET_EMAIL=user@example.com
NOTIFICATION_TARGET_PHONE=+15551234567
NOTIFICATION_INTERVAL_MINUTES=60

# Email Dispatcher (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# SMS Dispatcher (Twilio or Email-to-SMS)
# Default carrier for email-to-sms gateway: att, verizon, tmobile, sprint
SMS_CARRIER_GATEWAY=att
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
